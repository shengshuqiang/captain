<resources>

    <!-- ============================================ -->
    <!-- 基础主题 -->
    <!-- ============================================ -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/captain_brand_primary</item>
        <item name="colorPrimaryDark">@color/captain_brand_primary</item>
        <item name="colorAccent">@color/captain_brand_accent</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:windowBackground">@color/captain_surface_page</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <!-- ============================================ -->
    <!-- 按钮样式 -->
    <!-- ============================================ -->
    <style name="CaptainButton">
        <item name="android:textSize">@dimen/captain_text_card_title</item>
        <item name="android:minHeight">@dimen/captain_size_button_height</item>
        <item name="android:paddingStart">@dimen/captain_space_card_inner</item>
        <item name="android:paddingEnd">@dimen/captain_space_card_inner</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CaptainButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/captain_text_on_brand</item>
    </style>

    <style name="CaptainButton.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/captain_brand_primary</item>
    </style>

    <!-- ============================================ -->
    <!-- 卡片样式 -->
    <!-- ============================================ -->
    <style name="CaptainCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/captain_space_card_inner</item>
    </style>

    <style name="CaptainCard.Large">
        <item name="android:background">@drawable/bg_card_large</item>
    </style>

    <!-- ============================================ -->
    <!-- 文字样式 -->
    <!-- ============================================ -->
    <style name="CaptainText">
        <item name="android:textColor">@color/captain_text_primary</item>
    </style>

    <style name="CaptainText.Hero">
        <item name="android:textSize">@dimen/captain_text_hero</item>
        <item name="android:textColor">@color/captain_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CaptainText.PageTitle">
        <item name="android:textSize">@dimen/captain_text_page_title</item>
        <item name="android:textColor">@color/captain_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CaptainText.CardTitle">
        <item name="android:textSize">@dimen/captain_text_card_title</item>
        <item name="android:textColor">@color/captain_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CaptainText.Body">
        <item name="android:textSize">@dimen/captain_text_body</item>
        <item name="android:textColor">@color/captain_text_secondary</item>
    </style>

    <style name="CaptainText.Caption">
        <item name="android:textSize">@dimen/captain_text_caption</item>
        <item name="android:textColor">@color/captain_text_tertiary</item>
    </style>

</resources>
