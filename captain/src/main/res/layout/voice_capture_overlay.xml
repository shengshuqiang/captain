<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_capture_overlay"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/captain_voice_scrim"
    android:clickable="true" android:focusable="true">
    <!-- Only the candidate scrolls; confirm/cancel stay above the resizing IME. -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/captain_space_page_horizontal">
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:id="@+id/voice_capture_heading" style="@style/CaptainText.CardTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/captain_surface_card" android:gravity="center"
                android:paddingBottom="@dimen/captain_space_inline" />
            <EditText android:id="@+id/voice_capture_editor" style="@style/CaptainInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="4" android:maxLines="8" android:gravity="top|start"
                android:background="@drawable/bg_voice_transcript" android:inputType="textMultiLine|textCapSentences"
                android:padding="@dimen/captain_space_page_horizontal" android:scrollbars="vertical"
                android:saveEnabled="false" android:contentDescription="待确认语音文字" />
            <TextView android:id="@+id/voice_capture_tip" style="@style/CaptainText.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/captain_surface_card"
                android:padding="@dimen/captain_space_card_inner" />
            <ProgressBar android:id="@+id/voice_capture_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:indeterminate="true" android:indeterminateTint="@color/captain_brand_primary" />
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.4" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/captain_space_page_horizontal"
        android:paddingEnd="@dimen/captain_space_page_horizontal"
        android:paddingBottom="@dimen/captain_space_page_bottom">
        <Button android:id="@+id/voice_capture_stop" style="@style/CaptainButton.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/voice_capture_stop" android:singleLine="false"
            android:layout_marginBottom="@dimen/captain_space_inline" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/voice_capture_cancel" style="@style/CaptainButton.Secondary"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:singleLine="false" android:text="@string/voice_capture_cancel" />
            <Space android:layout_width="@dimen/captain_space_inline" android:layout_height="1dp" />
            <Button android:id="@+id/voice_capture_confirm" style="@style/CaptainButton.Primary"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minWidth="0dp" android:singleLine="false" android:text="@string/voice_capture_confirm" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
