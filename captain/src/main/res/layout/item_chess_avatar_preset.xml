<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/bg_chess_choice_idle">

    <ImageView
        android:id="@+id/avatar_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/chess_avatar_preview"
        android:src="@drawable/avatar_chess_helmet_red" />

    <TextView
        android:id="@+id/avatar_name"
        style="@style/CaptainText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/captain_text_primary" />

</LinearLayout>
