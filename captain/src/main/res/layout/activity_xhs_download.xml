<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/captain_xhs_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_xhs_surface"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xhs_download_page_title"
                    android:textColor="@color/captain_xhs_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/xhs_download_intro"
                    android:textColor="@color/captain_xhs_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/input_view"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_xhs_input"
                    android:gravity="top|start"
                    android:hint="@string/xhs_download_input_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/captain_xhs_text_primary"
                    android:textColorHint="@color/captain_xhs_text_secondary"
                    android:textSize="15sp"
                    tools:text="sunshine☀️ 发个之前的视频hhhh 一直很喜欢的skims+... https://www.xiaohongshu.com/explore/xxxx" />

                <Button
                    android:id="@+id/parse_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_xhs_primary_button"
                    android:text="@string/xhs_download_parse"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/mobile_retry_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_xhs_secondary_button"
                    android:text="@string/xhs_download_mobile_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/captain_xhs_text_primary" />

                <Button
                    android:id="@+id/manual_webview_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_xhs_secondary_button"
                    android:text="@string/xhs_download_manual_webview"
                    android:textAllCaps="false"
                    android:textColor="@color/captain_xhs_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/status_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_xhs_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp">

                <ProgressBar
                    android:id="@+id/status_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/xhs_download_idle_status"
                    android:textColor="@color/captain_xhs_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_xhs_surface"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/meta_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_xhs_badge"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/captain_text_caption"
                    tools:text="视频 · 1 项" />

                <TextView
                    android:id="@+id/meta_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/captain_xhs_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="一直很喜欢的 skims look" />

                <TextView
                    android:id="@+id/meta_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/captain_xhs_text_secondary"
                    android:textSize="14sp"
                    tools:text="作者：sunshine☀️" />

                <TextView
                    android:id="@+id/meta_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/captain_xhs_text_secondary"
                    android:textSize="@dimen/captain_text_caption"
                    tools:text="来源：网页 SSR · 预计保存 1 项" />

                <ImageView
                    android:id="@+id/cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="14dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_xhs_input"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/selection_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/captain_xhs_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="已选择 1 / 1 项" />

                    <TextView
                        android:id="@+id/select_all_button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_xhs_secondary_button"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="@string/xhs_download_select_all"
                        android:textColor="@color/captain_xhs_text_primary"
                        android:textSize="@dimen/captain_text_caption" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/media_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_xhs_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/secondary_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_xhs_secondary_button"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/xhs_download_open_album"
            android:textColor="@color/captain_xhs_text_primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_xhs_primary_button"
            android:enabled="false"
            android:text="@string/xhs_download_save_default"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resource_webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_xhs_bottom_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/resource_webview_close"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_xhs_secondary_button"
                android:text="@string/xhs_download_webview_close"
                android:textAllCaps="false"
                android:textColor="@color/captain_xhs_text_primary" />

            <TextView
                android:id="@+id/resource_webview_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/xhs_download_webview_manual_hint"
                android:textColor="@color/captain_xhs_text_secondary"
                android:textSize="@dimen/captain_text_caption" />

            <Button
                android:id="@+id/resource_webview_refresh"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_xhs_secondary_button"
                android:text="@string/xhs_download_webview_refresh"
                android:textAllCaps="false"
                android:textColor="@color/captain_xhs_text_primary" />
        </LinearLayout>

        <WebView
            android:id="@+id/resource_sniff_webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/white" />

        <Button
            android:id="@+id/resource_webview_extract"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_xhs_primary_button"
            android:text="@string/xhs_download_webview_extract"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
