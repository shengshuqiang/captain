<?xml version="1.0" encoding="utf-8"?>
<!-- 分类标题一直可见；全选按钮与折叠标题使用独立的点击区。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_xhs_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/media_group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingRight="8dp"
        android:textColor="@color/captain_xhs_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/media_group_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:background="@drawable/bg_xhs_secondary_button"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/captain_xhs_text_primary"
        android:textSize="13sp" />
</LinearLayout>
