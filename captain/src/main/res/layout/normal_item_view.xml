<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/captain_text_primary"
            android:textSize="@dimen/captain_text_card_title"/>

        <TextView
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:textColor="@color/captain_text_secondary"
            android:textSize="@dimen/captain_text_body"
            android:clickable="false"
            android:longClickable="false"
            android:contextClickable="false"
            android:inputType="textPassword"/>

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/captain_text_secondary"
            android:textSize="@dimen/captain_text_body"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operate"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/edit"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:padding="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_edit_note"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>

        <ImageView
            android:id="@+id/delete"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:padding="10dp"
            android:scaleType="fitXY"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>
    </LinearLayout>
</merge>