<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/captain_surface_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/captain_space_page_horizontal"
        android:paddingEnd="@dimen/captain_space_page_horizontal"
        android:paddingTop="@dimen/captain_space_block"
        android:paddingBottom="@dimen/captain_space_block">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/captain_space_card_inner">

            <ImageView
                android:id="@+id/opponent_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/chess_opponent_label"
                android:src="@drawable/avatar_chess_helmet_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/captain_space_card_inner"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CaptainText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chess_opponent_label" />

                <TextView
                    android:id="@+id/opponent_name"
                    style="@style/CaptainText.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/opponent_color"
                style="@style/CaptainText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chess_tag"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/captain_text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/captain_space_block"
            android:background="@drawable/bg_card_large"
            android:orientation="vertical"
            android:padding="@dimen/captain_space_card_inner">

            <com.shuqiang.captain.chess.ui.ChessBoardView
                android:id="@+id/chess_board_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/flip_button"
                style="@style/CaptainButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/captain_space_inline"
                android:text="@string/chess_flip_board" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/captain_space_block"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/captain_space_card_inner">

            <ImageView
                android:id="@+id/my_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/chess_me_label"
                android:src="@drawable/avatar_chess_helmet_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/captain_space_card_inner"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CaptainText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chess_me_label" />

                <TextView
                    android:id="@+id/my_name"
                    style="@style/CaptainText.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/my_color"
                style="@style/CaptainText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chess_tag"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/captain_text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/captain_space_block"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/captain_space_card_inner">

            <TextView
                style="@style/CaptainText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chess_status_label" />

            <TextView
                android:id="@+id/game_status_text"
                style="@style/CaptainText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/captain_text_primary" />

            <TextView
                style="@style/CaptainText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/captain_space_inline"
                android:text="@string/chess_move_label" />

            <TextView
                android:id="@+id/last_move_text"
                style="@style/CaptainText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/captain_text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/captain_space_block"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/draw_button"
                style="@style/CaptainButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chess_draw_action" />

            <Button
                android:id="@+id/resign_button"
                style="@style/CaptainButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/chess_resign_action" />

            <Button
                android:id="@+id/replay_button"
                style="@style/CaptainButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/chess_replay_action"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
