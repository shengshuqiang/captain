<?xml version="1.0" encoding="utf-8"?>
<!-- 输入与结果摘要作为列表头，由同一个 RecyclerView 负责滚动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_xhs_surface"
        android:elevation="0dp"
        android:orientation="vertical"
        android:padding="@dimen/captain_space_card_inner">

        <TextView
            style="@style/CaptainText.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xhs_download_page_title"
            android:textColor="@color/captain_xhs_text_primary"
            android:textSize="@dimen/captain_text_page_title"
            android:textStyle="bold" />

        <TextView
            style="@style/CaptainText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/xhs_download_intro"
            android:textColor="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_caption" />

        <EditText
            style="@style/CaptainInput"
            android:id="@+id/input_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:minLines="4"
                android:maxLines="8"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_xhs_input"
            android:gravity="top|start"
            android:hint="@string/xhs_download_input_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="@dimen/captain_space_card_inner"
            android:textColor="@color/captain_xhs_text_primary"
            android:textColorHint="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_body"
            tools:text="sunshine☀️ 发个之前的视频hhhh 一直很喜欢的skims+... https://www.xiaohongshu.com/explore/xxxx" />

        <Button
            style="@style/CaptainButton.Primary"
            android:id="@+id/parse_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/captain_size_button_height"
            android:layout_marginTop="14dp"
            android:text="@string/xhs_download_parse"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            style="@style/CaptainButton.Secondary"
            android:id="@+id/mobile_retry_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/captain_size_button_height"
            android:layout_marginTop="8dp"
            android:text="@string/xhs_download_mobile_retry"
            android:textAllCaps="false" />

        <Button
            style="@style/CaptainButton.Secondary"
            android:id="@+id/manual_webview_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/captain_size_button_height"
            android:layout_marginTop="8dp"
            android:text="@string/xhs_download_manual_webview"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_xhs_status"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp">

        <ProgressBar
            android:id="@+id/status_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="10dp"
            android:visibility="gone" />

        <TextView
            style="@style/CaptainText.Caption"
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/xhs_download_idle_status"
            android:textColor="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_xhs_surface"
        android:elevation="0dp"
        android:orientation="vertical"
        android:padding="@dimen/captain_space_card_inner"
        android:visibility="gone">

        <TextView
            style="@style/CaptainText.Caption"
            android:id="@+id/meta_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_xhs_badge"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/captain_text_caption"
            tools:text="视频 · 1 项" />

        <TextView
            style="@style/CaptainText.CardTitle"
            android:id="@+id/meta_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/captain_xhs_text_primary"
            android:textSize="@dimen/captain_text_card_title"
            android:textStyle="bold"
            tools:text="一直很喜欢的 skims look" />

        <TextView
            style="@style/CaptainText.Caption"
            android:id="@+id/meta_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_caption"
            tools:text="作者：sunshine☀️" />

        <TextView
            style="@style/CaptainText.Caption"
            android:id="@+id/meta_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_caption"
            tools:text="来源：网页 SSR · 预计保存 1 项" />

        <TextView
            style="@style/CaptainText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="先视频后图片，同类按分辨率从大到小；点击分类可展开或收起。"
            android:textColor="@color/captain_xhs_text_secondary"
            android:textSize="@dimen/captain_text_caption" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CaptainText.Caption"
                android:id="@+id/selection_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/captain_xhs_text_primary"
                android:textSize="@dimen/captain_text_caption"
                android:textStyle="bold"
                tools:text="已选择 1 / 1 项" />

            <TextView
                style="@style/CaptainButton.Secondary"
                android:id="@+id/select_all_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/captain_size_button_height"
                android:background="@drawable/bg_xhs_secondary_button"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/xhs_download_select_all"
                android:textColor="@color/captain_xhs_text_primary"
                android:textSize="@dimen/captain_text_body" />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>
