<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/captain_surface_page">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/captain_space_page_horizontal"
        android:paddingTop="@dimen/captain_space_block"
        android:paddingEnd="@dimen/captain_space_page_horizontal"
        android:paddingBottom="@dimen/captain_space_block"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/empty_history_text"
        style="@style/CaptainText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/chess_no_history"
        android:visibility="gone" />

</FrameLayout>
