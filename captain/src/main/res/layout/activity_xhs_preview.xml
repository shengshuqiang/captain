<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/preview_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="@dimen/captain_space_card_inner"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/preview_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_xhs_preview_chip"
            android:minHeight="@dimen/captain_size_button_height"
            android:minWidth="@dimen/captain_size_button_height"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="@string/xhs_preview_close"
            android:textColor="@android:color/white"
            android:textSize="@dimen/captain_text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_xhs_preview_chip"
            android:minHeight="@dimen/captain_size_button_height"
            android:minWidth="@dimen/captain_size_button_height"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="@string/xhs_preview_save"
            android:textColor="@android:color/white"
            android:textSize="@dimen/captain_text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_xhs_preview_chip"
            android:minHeight="@dimen/captain_size_button_height"
            android:minWidth="@dimen/captain_size_button_height"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/captain_text_caption"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
