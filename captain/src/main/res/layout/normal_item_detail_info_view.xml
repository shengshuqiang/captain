<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical">

    <LinearLayout
        android:id="@+id/operate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/captain_size_button_height"
        android:paddingLeft="@dimen/captain_space_card_inner"
        android:paddingRight="@dimen/captain_space_card_inner"
        android:gravity="right|center_vertical"
        android:orientation="horizontal"
        android:background="@color/captain_surface_toolbar">

        <ImageView
            android:id="@+id/cancel"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/captain_size_button_height"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/edit"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:src="@drawable/ic_edit_note"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>

        <ImageView
            android:id="@+id/delete"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>

        <ImageView
            android:id="@+id/ok"
            android:layout_width="@dimen/captain_size_button_height"
            android:layout_height="@dimen/captain_size_button_height"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_done"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/captain_text_primary"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <EditText
            style="@style/CaptainInput"
            android:id="@+id/user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/captain_text_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="账号"
            android:textSize="@dimen/captain_text_body"/>

        <EditText
            style="@style/CaptainInput"
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/captain_text_secondary"
            android:inputType="textVisiblePassword"
            android:hint="密码"
            android:textSize="@dimen/captain_text_body"/>

        <EditText
            style="@style/CaptainInput"
            android:id="@+id/remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/captain_text_secondary"
            android:inputType="textPhonetic"
            android:layout_marginTop="10dp"
            android:hint="备注"
            android:textSize="@dimen/captain_text_body"/>
    </LinearLayout>
</merge>