<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/captain_space_card_inner">

    <ImageView
        android:id="@+id/icon"
        android:layout_height="@dimen/captain_size_avatar"
        android:layout_width="@dimen/captain_size_avatar"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:contentDescription="@string/grid_item_icon_description"/>

    <TextView
        android:id="@+id/title"
        style="@style/CaptainText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/captain_space_inline"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"/>

</LinearLayout>
