<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#14E64A5B" />
            <corners android:radius="@dimen/captain_radius_card" />
            <stroke
                android:width="1dp"
                android:color="@color/captain_xhs_brand_primary_dark" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/captain_radius_card" />
            <stroke
                android:width="1dp"
                android:color="@color/captain_xhs_divider" />
        </shape>
    </item>
</selector>
