<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#14E64A5B" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/xhsPrimaryDark" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/xhsDivider" />
        </shape>
    </item>
</selector>
