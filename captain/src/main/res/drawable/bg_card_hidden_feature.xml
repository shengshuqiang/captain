<?xml version="1.0" encoding="utf-8"?>
<!-- 隐藏功能卡片使用虚线描边，便于和常规入口区分。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/captain_surface_card" />
    <stroke
        android:width="1dp"
        android:color="@color/captain_border_strong"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
    <corners android:radius="@dimen/captain_radius_card" />
</shape>
