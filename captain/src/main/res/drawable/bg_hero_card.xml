<?xml version="1.0" encoding="utf-8"?>
<!-- 首页欢迎区收敛为轻量卡片，保留品牌识别同时给桌面区让位。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="180"
        android:startColor="@color/captain_surface_hero"
        android:endColor="@color/captain_surface_page"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/captain_border_soft" />
    <corners android:radius="@dimen/captain_radius_card_large" />
</shape>
