<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮背景 - 品牌渐变,含按下/禁用态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用态:中性灰 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_gray_300" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <!-- 按下态:更深品牌色 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_brand_800" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <!-- 默认态:品牌渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/captain_brand_700"
                android:endColor="@color/captain_brand_accent"
                android:type="linear" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
</selector>
