<?xml version="1.0" encoding="utf-8"?>
<!-- 语义填充及禁用/按压/焦点状态，不依赖额外阴影或描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_gray_100" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_brand_200" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_brand_200" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_brand_100" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
</selector>
