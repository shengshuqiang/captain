<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮背景 - 白底品牌描边,含按下/禁用态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 禁用态:中性灰底 + 灰描边 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_gray_100" />
            <stroke
                android:width="1dp"
                android:color="@color/captain_gray_400" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <!-- 按下态:浅品牌底 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_brand_100" />
            <stroke
                android:width="1dp"
                android:color="@color/captain_brand_500" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
    <!-- 默认态:白底 + 品牌描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/captain_surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/captain_brand_500" />
            <corners android:radius="@dimen/captain_radius_control" />
        </shape>
    </item>
</selector>
