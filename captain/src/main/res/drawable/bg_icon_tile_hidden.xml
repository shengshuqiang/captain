<?xml version="1.0" encoding="utf-8"?>
<!-- 隐藏功能图标底板使用虚线描边，方便和公开入口区分。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/captain_surface_card_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/captain_border_strong"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
    <corners android:radius="@dimen/captain_radius_icon_tile" />
</shape>
