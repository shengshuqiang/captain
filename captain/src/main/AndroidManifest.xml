<?xml version="1.0" encoding="utf-8"?><manifest xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
package="captain">

<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.BLUETOOTH" />
<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:targetApi="s" />
<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
<uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
<uses-permission android:name="android.permission.USE_FINGERPRINT" />
<uses-permission android:name="android.permission.USE_BIOMETRIC" />

<application
    android:name="com.shuqiang.captain.CaptainApplication"
    android:usesCleartextTraffic="true"
    android:allowBackup="true"
    android:icon="@drawable/captain"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:requestLegacyExternalStorage="true"
    android:theme="@style/AppTheme.NoActionBar">

    <activity
        android:name="com.shuqiang.captain.MainActivity"
        android:label="船长"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <activity
        android:name="com.shuqiang.captain.qr.QRActivity"
        android:label="信息二维码">

    </activity>

    <activity
        android:name="com.shuqiang.captain.qr.scan.QrScanActivity"
        android:exported="false"
        android:label="@string/qr_scan_title" />

    <activity
        android:name="com.shuqiang.captain.chess.ui.ChessOnboardingActivity"
        android:exported="false"
        android:label="@string/chess_onboarding_title" />

    <activity
        android:name="com.shuqiang.captain.chess.ui.ChessLobbyActivity"
        android:exported="false"
        android:label="@string/chess_title" />

    <activity
        android:name="com.shuqiang.captain.chess.ui.ChessGameActivity"
        android:exported="false"
        android:label="@string/chess_game_title" />

    <activity
        android:name="com.shuqiang.captain.chess.ui.ChessHistoryActivity"
        android:exported="false"
        android:label="@string/chess_history_title" />

    <activity
        android:name="com.shuqiang.captain.chess.ui.ChessReplayActivity"
        android:exported="false"
        android:label="@string/chess_replay_title" />

    <activity
        android:name="com.shuqiang.captain.xhs.ui.XhsDownloadActivity"
        android:exported="true"
        android:label="@string/xhs_download_page_title"
        android:launchMode="singleTop">
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
            <data android:mimeType="text/*" />
        </intent-filter>
    </activity>

    <activity
        android:name="com.shuqiang.captain.xhs.ui.XhsPreviewActivity"
        android:exported="false"
        android:label="资源预览" />

    <activity
        android:name="com.shuqiang.captain.timer.TimerChannelActivity"
        android:exported="false"
        android:label="@string/timer_channel_title"
        android:screenOrientation="landscape"
        android:theme="@style/AppTheme.NoActionBar" />

    <activity
        android:name="com.shuqiang.captain.qr.test.QRTestActivity"
        android:exported="true"
        android:label="信息二维码测试页"
        >
    </activity>

    <service
        android:name="com.shuqiang.captain.xhs.download.XhsDownloadService"
        android:exported="false" />

</application>

</manifest>
