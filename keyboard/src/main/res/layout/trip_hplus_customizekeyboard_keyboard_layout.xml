<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/trip_hplus_customizekeyboard_divider"
    android:showDividers="beginning|middle"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">


    <TextView
        android:id="@+id/complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingVertical="12dp"
        android:paddingRight="15dp"
        android:background="@drawable/trip_hplus_customizekeyboard_keyboard_key_selector"
        android:gravity="right|center_vertical"
        android:textColor="?android:attr/colorAccent"
        android:textSize="16sp"
        android:text="完成"/>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/trip_hplus_customizekeyboard_divider"
        android:keyBackground="@drawable/trip_hplus_customizekeyboard_keyboard_key_selector"
        android:keyTextColor="?android:attr/textColorPrimary"
        android:keyTextSize="23sp"
        android:focusable="true"
        android:focusableInTouchMode="true"/>
</LinearLayout>